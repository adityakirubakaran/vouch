# Copy to .env and fill in what you have. Everything except the Claude key is optional.

# --- Claude -----------------------------------------------------------------
# Without a key Vouch runs in offline mode: scripted responses that only work
# with the two bundled sample applications.
ANTHROPIC_API_KEY=
# MODEL_SMART=claude-sonnet-5-5   # reads applications, transcripts, bank replies; writes memos
# MODEL_FAST=claude-haiku-5-5     # live phone turns and live note-taking

# --- Who is extending credit -------------------------------------------------
SELLER_NAME=Northline Supply
SELLER_CONTACT_EMAIL=credit@northlinesupply.example

# --- Reference calls ---------------------------------------------------------
# simulated: Claude plays each reference (no phone needed)
# browser:   a teammate answers in the app's Phone page, by voice or typing
# twilio:    real phone calls through Twilio ConversationRelay
CALL_CHANNEL=simulated
CALL_MAX_ATTEMPTS=3
CALL_RETRY_SECONDS=30
CALL_RING_TIMEOUT_SECONDS=45

# Twilio (only for CALL_CHANNEL=twilio). PUBLIC_BASE_URL must be an https URL
# that reaches this server, e.g. from `make tunnel`.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
# Send every reference call to this phone during a live demo (E.164, +1...).
DEMO_REFERENCE_PHONE=
# TWILIO_TTS_PROVIDER=ElevenLabs
# TWILIO_VOICE=
# TWILIO_AMD=true

# --- Bank reference email ----------------------------------------------------
# outbox: emails show up in the app; the sample banks reply after a few seconds
# smtp:   send real email (replies come back through POST /api/email/inbound)
EMAIL_MODE=outbox
SIMULATE_BANK_REPLY_SECONDS=8
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Business registry -------------------------------------------------------
# sandbox: built-in records for the demo companies
# opencorporates: live lookups (needs an API token) for real companies
REGISTRY_MODE=sandbox
OPENCORPORATES_API_TOKEN=
LIVE_DOMAIN_CHECKS=true

# --- Phone checks on trade references ----------------------------------------
# Who does each reference's phone number really belong to? Each service is used
# when its key is set; the demo numbers always use built-in sandbox data.
# IPQualityScore: phone fraud score, VoIP, recent abuse (1,000 free lookups)
IPQS_API_KEY=
# Google Places API (New): which business lists the number (Text Search, Enterprise fields)
GOOGLE_MAPS_API_KEY=
# Twilio Lookup: caller ID name and line type, using the Twilio keys above
# TWILIO_LOOKUP=true
# Try a real number: make phone NUMBER="+14155551234" COMPANY="Name"

# --- Accounting --------------------------------------------------------------
# ledger: approved customers are written to data/ledger.json
# quickbooks: create the customer in a QuickBooks Online sandbox company
ACCOUNTING_MODE=ledger
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
